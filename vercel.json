{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/pay-status",
      "destination": "/api/payment/status"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/api/sw",
      "destination": "/api/rate?sw=1"
    },
    {
      "source": "/platform",
      "destination": "/platform/index.html"
    }
  ],
  "functions": {
    "api/read.js": {
      "includeFiles": "api/_lib/card-meanings*.json"
    },
    "api/deeper.js": {
      "includeFiles": "api/_lib/card-meanings*.json"
    },
    "api/rate.js": {
      "includeFiles": "{api/_lib/card-meanings*.json,node_modules/astronomy-engine/astronomy.js,node_modules/astronomy-engine/package.json}"
    }
  }
}
