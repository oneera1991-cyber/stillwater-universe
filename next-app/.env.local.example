# AI Provider — set one of the following
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Which AI provider to use: "openai" or "anthropic"
AI_PROVIDER=openai

# OpenAI model (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Anthropic model (default: claude-3-haiku-20240307)
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Payhip product URLs (replace with your real Payhip links)
NEXT_PUBLIC_PAYHIP_STARTER_URL=https://payhip.com/b/STARTER_PLACEHOLDER
NEXT_PUBLIC_PAYHIP_DEEPER_URL=https://payhip.com/b/DEEPER_PLACEHOLDER

# Base URL for redirect after payment
NEXT_PUBLIC_BASE_URL=http://localhost:3000
